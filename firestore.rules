// ============================================
// DISCIPLANT — Firestore security rules
//
// Paste into Firebase Console -> Firestore Database -> Rules,
// then Publish. Nothing in the app works against the old
// owner-only ruleset once usernames/friends are in play.
//
// Editing this file alone changes NOTHING in production — the
// deployed rules are whatever was last pasted into the Console.
// Re-publish after every change here, or viewing a friend's
// garden fails with permission-denied while everything else
// keeps working (which is exactly the kind of failure that looks
// like a code bug).
// ============================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function me()         { return request.auth.uid; }
    function changed()    { return request.resource.data.diff(resource.data).affectedKeys(); }


    // ============================================
    // RATE LIMITING — the tunable numbers
    //
    // THESE ARE THE KILL SWITCH. Under attack, cut the Max numbers to
    // something like 20, paste, and hit Publish — it applies within
    // about a minute and needs no deploy. Everything else in this file
    // can stay as it is.
    //
    // How the limiter works, in one paragraph: every rate-limited
    // document carries its own counter — an "At" (when it was last
    // written), a "Start" (when the current counting window opened)
    // and a "Count" (writes so far in that window). The rules below
    // allow a write only if it either continues the current window
    // with exactly one more write and stays under the ceiling, or
    // opens a fresh window once the old one has genuinely expired.
    // Because the counter lives ON the document being written,
    // checking it reads `resource`, which Firestore does NOT bill as a
    // document read — so this costs nothing per write. A separate
    // /rateLimits collection would have cost one billed read every
    // single time.
    //
    // The window is fixed, not sliding: it opens on the first write
    // and resets one window later. So the true ceiling at a window
    // boundary is briefly up to 2x the number below. That is a
    // deliberate trade for the zero-read design.
    //
    // Two counters live on users/{uid} because a CREATE cannot check
    // itself — a document that does not exist yet has no counter to
    // read. friendRequests therefore hangs its counter on the sender's
    // user document and is forced, by getAfter() below, to bump it in
    // the same batch. That one costs a billed read, which is fine for
    // an action a person takes a handful of times.
    // ============================================

    function rlWindow()       { return duration.value(10, 'm'); }   // gardens, profile
    function rlSocialWindow() { return duration.value(1,  'h'); }   // friend requests
    function rlGardenMax()    { return 200; }
    function rlSummaryMax()   { return 200; }
    function rlUserMax()      { return 20;  }
    function rlFriendReqMax() { return 20;  }

    // Stand-in for "this document has no counter yet". Any real
    // window start is far newer than this, so a document written
    // before these rules existed always takes the fresh-window branch
    // on its next write and adopts a counter automatically. No
    // migration, no backfill script.
    function rlEpoch()        { return timestamp.date(2000, 1, 1); }


    // ---- The generic limiter, on the rl* fields ----
    //
    // rlAt == request.time forces the client to use
    // FieldValue.serverTimestamp(): request.time is the server's
    // clock, so a client cannot backdate its own counter to look
    // idle. The same trick is what makes rlStart unforgeable.
    function rlOkUpdate(maxWrites, window) {
      return request.resource.data.rlAt == request.time
        && (
             ( request.resource.data.rlStart == request.time
               && request.resource.data.rlCount == 1
               && request.time > resource.data.get('rlStart', rlEpoch()) + window )
             ||
             ( request.resource.data.rlStart == resource.data.get('rlStart', rlEpoch())
               && request.resource.data.rlCount == resource.data.get('rlCount', 0) + 1
               && request.resource.data.rlCount <= maxWrites )
           );
    }

    // For a CREATE, where `resource` is null and cannot be read.
    function rlOkCreate() {
      return request.resource.data.rlAt    == request.time
        &&   request.resource.data.rlStart == request.time
        &&   request.resource.data.rlCount == 1;
    }


    // ---- The second counter on users/{uid}, on the fr* fields ----
    //
    // Only friend-request sends touch these. Every other write to a
    // user document leaves them alone, which is what frUntouched()
    // permits — so an ordinary profile save is not charged against the
    // social budget.
    function frUntouched() {
      return !changed().hasAny(['frAt', 'frStart', 'frCount']);
    }

    function frOk() {
      return request.resource.data.frAt == request.time
        && (
             ( request.resource.data.frStart == request.time
               && request.resource.data.frCount == 1
               && request.time > resource.data.get('frStart', rlEpoch()) + rlSocialWindow() )
             ||
             ( request.resource.data.frStart == resource.data.get('frStart', rlEpoch())
               && request.resource.data.frCount == resource.data.get('frCount', 0) + 1
               && request.resource.data.frCount <= rlFriendReqMax() )
           );
    }


    // ---- Username: write once, never again ----
    //
    // This is the whole anti-squatting mechanism, and it is stronger
    // than a rate limit would be: a rate limit slows down claiming
    // many names, this makes it impossible to hold more than one. A
    // user document may set `username` while it has none, and after
    // that the field is frozen. Renaming is therefore an Admin SDK
    // job, deliberately.
    //
    // The other half is on /usernames below, which refuses to create a
    // reservation unless this document ends the same transaction
    // pointing at exactly that name.
    function usernameWriteOnce() {
      return ( !('username' in resource.data)
               || request.resource.data.get('username', null) == resource.data.username )
        &&   ( !('usernameLower' in resource.data)
               || request.resource.data.get('usernameLower', null) == resource.data.usernameLower );
    }


    // Am I on this person's friends list?
    //
    // The friends array on THEIR user doc is the authority, not mine —
    // a rule can only be trusted if it reads state the requester can't
    // forge, and I can't write to their document except through the
    // narrow accept-a-request rule below. Note this costs one extra
    // document read per evaluation (billed, and counted against the
    // 10-document limit for rule lookups), so it's only called from
    // the gardenSummaries rules and never from a rule that runs on
    // every ordinary write.
    function isFriend(ownerUid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(ownerUid))
             .data.get('friends', []).hasAny([me()]);
    }

    // ============================================
    // ACCOUNT DELETION — the "all four, or none" rule
    //
    // A person's data lives in four documents: gardens/{uid},
    // gardenSummaries/{uid}, users/{uid} and their one reservation in
    // /usernames. Erasing an account has to remove all four, and every
    // delete rule below refuses unless the OTHERS are going too. The
    // check is existsAfter(), which reads the state a document will be
    // in once this commit lands — so the only way to satisfy all four
    // at once is a single atomic batch, and a half-finished deletion
    // cannot exist.
    //
    // That mutual dependency is doing real work, not tidiness:
    //
    //   * Delete IS a counter reset. The rate limiter (above) keeps its
    //     count ON the document being written, so a lone delete would
    //     hand the account a fresh window whenever it liked. Tying the
    //     delete to losing the whole account makes that pointless.
    //   * A lone users/{uid} delete would strand the username. The name
    //     is frozen by usernameWriteOnce() precisely so nobody holds
    //     two — but a user who dropped the profile document while
    //     keeping the reservation could then claim a SECOND name on the
    //     recreated document. Requiring the reservation to go in the
    //     same commit closes that.
    //   * A lone usernames delete would free the name while its holder
    //     could never claim another, which is why that rule was `if
    //     false` before this.
    //
    // NOTHING HERE LETS ANYONE DELETE ANYONE ELSE. Every rule is
    // me() == uid, or (for the reservation) resource.data.uid == me().
    // A signed-in attacker asking to delete another person's garden
    // fails on the first clause and never reaches the existsAfter()
    // calls.
    //
    // Cost: one billed document access per existsAfter(). Six in total
    // for a full deletion, once in the life of an account.
    // ============================================

    function gone(path) {
      return !existsAfter(path);
    }

    // ---- Garden data — owner only, rate limited ----
    // Deliberately NOT opened up to friends. Rules are document-level,
    // so there is no way to expose growth/streaks from this document
    // without also exposing every task's raw text and full history.
    // The friend-visible subset lives in gardenSummaries below.
    //
    // DELETE is the owner's, but ONLY as part of deleting the whole
    // account — see the block above. It used to be flatly denied
    // because a lone delete resets the rate-limit counter; requiring
    // the profile document to go in the same commit keeps that true
    // while still allowing erasure.
    // ---- The Dew wallet (15-wallet.js, 18-market.js) ----
    //
    // The wallet rides on gardens/{uid} and the browser writes it, so
    // these checks cannot make it honest - a determined owner can
    // still edit earned and bal together. What they do is make the
    // one-number edit fail: the balance has to be what was earned
    // minus what was spent, a look can only join `owned` in a write
    // that also spends, and nobody can hold more Mulch or Fertilizer
    // than the Booster Market sells. The app keeps all three true itself (see
    // dewCredit, dewRefund and dewNormalizeWallet), so an honest save
    // never trips them. Roadmap I3.
    //
    // No per-write cap on how much the balance can rise: saves are
    // coalesced (SAVE_MIN_INTERVAL_MS in 02), so a first visit to
    // Rewards can legitimately collect several hundred Dew in one
    // write. Costs nothing - only `request.resource` and `resource`.
    function walletOk(old) {
      let w = request.resource.data.get('wallet', null);
      return w == null || (
        w.bal is number && w.earned is number && w.spent is number
        && w.earned >= 0 && w.spent >= 0
        && w.bal == w.earned - w.spent
        && w.bal <= 99999
        && (!('mk' in w) || !('mulch' in w.mk) || (w.mk.mulch is number && w.mk.mulch <= 3))
        && (!('mk' in w) || !('fz' in w.mk) || (w.mk.fz is number && w.mk.fz <= 3))
        && ownedOk(w, old)
      );
    }

    function ownedOk(w, old) {
      return old == null || !('owned' in old) || !('owned' in w)
        || w.owned.size() <= old.owned.size()
        || w.spent > old.spent;
    }

    match /gardens/{uid} {
      allow read:   if isSignedIn() && me() == uid;
      allow create: if isSignedIn() && me() == uid && rlOkCreate() && walletOk(null);
      allow update: if isSignedIn() && me() == uid && rlOkUpdate(rlGardenMax(), rlWindow())
        && walletOk(resource.data.get('wallet', null));
      allow delete: if isSignedIn() && me() == uid
        && gone(/databases/$(database)/documents/users/$(uid));
    }

    // ---- Public community counters ----
    // A single document, /stats/global, holding aggregate numbers for
    // the home page: how many gardeners, how many habits growing, how
    // many days completed. Nothing in it identifies anybody.
    //
    // NO CLIENT MAY EVER WRITE HERE. It is produced entirely by
    // recompute-stats.js, run by hand through the Admin SDK, which
    // bypasses these rules altogether — so `allow write: if false`
    // costs the script nothing and removes the whole attack surface.
    // A client-writable counter would need a rule letting users edit a
    // document they don't own, and no rule can verify the events being
    // counted actually happened.
    //
    // Read is open rather than isSignedIn() so the home page can paint
    // the numbers immediately, without waiting on anonymous sign-in.
    match /stats/{statsDoc} {
      allow read:  if true;
      allow write: if false;
    }

    // ---- Friend-visible garden summary ----
    // A derived, deliberately lossy projection of gardens/{uid},
    // rewritten by the owner every time they save (see saveData() in
    // 02-auth-tasks.js). It holds only what a friend is meant to see —
    // species, skin, growth, streak, position — and never task text or
    // per-day history.
    //
    // Writes stay owner-only: this document is derived data, and
    // letting anyone else touch it would let them fake a friend's
    // garden. Reads are owner-or-friend.
    //
    // Rate limited separately from gardens even though the app always
    // writes the two together, because the app is not the only thing
    // that can write here — a hostile client could hammer this path
    // alone. Delete is account-deletion-only, same as gardens.
    //
    // This is the document that actually leaks if erasure is sloppy:
    // it is the one thing in the database another person can read. It
    // has to be gone, not merely emptied.
    match /gardenSummaries/{uid} {
      allow read:   if isSignedIn() && (me() == uid || isFriend(uid));
      allow create: if isSignedIn() && me() == uid && rlOkCreate();
      allow update: if isSignedIn() && me() == uid && rlOkUpdate(rlSummaryMax(), rlWindow());
      allow delete: if isSignedIn() && me() == uid
        && gone(/databases/$(database)/documents/users/$(uid));
    }

    // ---- User profiles ----
    // The email lives here, so nobody else can read this document.
    // Other users' display names come from /usernames instead.
    //
    // Every owner write must advance the rl* counter. That covers the
    // profile save in ensureUserProfileDoc(), the username claim, and
    // the half of accepting a friend request that touches my own
    // document. The fr* counter is only advanced by a friend-request
    // send, and frUntouched() keeps ordinary writes off that budget.
    //
    // Delete denied: same counter-reset reasoning as gardens.
    match /users/{uid} {
      allow read: if isSignedIn() && me() == uid;

      allow create: if isSignedIn() && me() == uid && rlOkCreate();

      allow update: if isSignedIn()
        && me() == uid
        && usernameWriteOnce()
        && rlOkUpdate(rlUserMax(), rlWindow())
        && (frUntouched() || frOk());

      // Accepting a friend request: the ONLY write anyone else may make
      // to this document. It can add exactly one UID (their own) to
      // `friends`, cannot remove anything, cannot touch another field,
      // and only works if this document's owner sent them a request.
      //
      // Deliberately NOT rate limited, and it must not be: the counter
      // belongs to this document's owner, and hasOnly(['friends'])
      // already forbids the requester from touching it. Their own
      // budget is charged on their own document, in the same batch.
      allow update: if isSignedIn()
        && me() != uid
        && changed().hasOnly(['friends'])
        && request.resource.data.friends.hasAll(resource.data.get('friends', []))
        && request.resource.data.friends
             .hasOnly(resource.data.get('friends', []).concat([me()]))
        && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + me()));

      // Taking MYSELF off someone else's friends list. This is what
      // makes a deleted account disappear from the people who were
      // friends with it, and it is the second and last write anyone
      // else may make to this document.
      //
      // It is deliberately narrow in both directions:
      //   * hasOnly(['friends']) — no other field can be touched, so
      //     the owner's rate-limit counters, username and email are
      //     all out of reach. That is also why this branch needs no
      //     counter of its own: there is nothing here to spend.
      //   * the after-list must equal the before-list minus exactly
      //     one entry, my own uid. hasOnly + hasAll together is set
      //     equality, so nothing can be added, and nobody ELSE can be
      //     removed. Someone trying to quietly unfriend two people who
      //     know each other is rejected.
      //
      // The `hasAny([me()])` line is not decoration: without it this
      // write would still be permitted once my uid was already gone,
      // and an attacker could hammer a stranger's document with
      // no-ops forever. With it, the write succeeds exactly once and
      // every repeat is denied.
      //
      // Yes, this is also a one-sided unfriend, which was previously
      // out of scope. There is no way to have erasure without it: the
      // alternative is a deleted person's uid sitting on other
      // people's documents indefinitely.
      allow update: if isSignedIn()
        && me() != uid
        && changed().hasOnly(['friends'])
        && resource.data.get('friends', []).hasAny([me()])
        && request.resource.data.friends
             .hasOnly(resource.data.friends.removeAll([me()]))
        && request.resource.data.friends
             .hasAll(resource.data.friends.removeAll([me()]));

      // Deleting my own profile document — the hinge of the whole
      // deletion, since every other delete rule checks that THIS one
      // is gone. It in turn checks the garden documents and the
      // username reservation, so the four can only ever go together.
      //
      // resource == null short-circuits before resource.data is
      // touched: rules abort on a field read against a document that
      // does not exist, and an account that never claimed a username
      // has no usernameLower at all.
      allow delete: if isSignedIn()
        && me() == uid
        && gone(/databases/$(database)/documents/gardens/$(uid))
        && gone(/databases/$(database)/documents/gardenSummaries/$(uid))
        && ( resource == null
             || !('usernameLower' in resource.data)
             || gone(/databases/$(database)/documents/usernames/$(resource.data.usernameLower)) );
    }

    // ---- Username reservations / public directory ----
    // Doc ID is the lowercased name, which is what makes it unique:
    // create only ever succeeds when the name is free.
    //
    // The getAfter() line is the anti-squatting half. getAfter reads
    // the state a document will be in once this transaction commits,
    // so it forces the claim to happen together with the matching
    // write to users/{me}. Combined with usernameWriteOnce() above,
    // that means a second name would require changing a frozen field,
    // so nobody can ever hold more than one. This is why /usernames
    // needs no counter of its own.
    //
    // Costs one billed document read per claim — an action taken once
    // in the life of an account.
    //
    // Delete releases the name, and is allowed ONLY to the account
    // that holds it and ONLY as part of deleting that account. On its
    // own it would strand the holder: the username is frozen on their
    // user document, so the name would be free for someone else while
    // they could never claim another. Requiring users/{me} to be gone
    // in the same commit means the name is only ever released by
    // someone who is leaving.
    //
    // A released name becomes claimable again by anyone. That is the
    // honest trade for erasure — keeping it reserved forever would
    // mean keeping a record of a deleted person.
    match /usernames/{name} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && name == request.resource.data.username.lower()
        && name.matches('^[a-z0-9_]{3,20}$')
        && getAfter(/databases/$(database)/documents/users/$(me()))
             .data.get('usernameLower', '') == name;

      allow update: if false;                                   // no renames

      allow delete: if isSignedIn()
        && resource.data.uid == me()
        && gone(/databases/$(database)/documents/users/$(me()));
    }

    // ---- Friend requests ----
    // Doc ID is always {fromUid}_{toUid}, enforced on create, so one
    // pair can never have two competing request documents.
    //
    // The getAfter() line forces every send to be a BATCH that also
    // advances fr* on the sender's own user document. The arithmetic
    // is checked by frOk() up in the users rule; all this needs to
    // verify is that the bump happened in this same commit, which
    // frAt == request.time proves.
    match /friendRequests/{reqId} {
      allow read: if isSignedIn()
        && (resource.data.from == me() || resource.data.to == me());

      allow create: if isSignedIn()
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && reqId == me() + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.to + '_' + me()))
        && getAfter(/databases/$(database)/documents/users/$(me())).data.frAt == request.time;

      // Only the recipient decides the outcome.
      allow update: if isSignedIn()
        && resource.data.to == me()
        && changed().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['accepted', 'declined'];

      // Either side can clear it away (decline, cancel a sent request,
      // or sweep up on the way out of a deleted account). Not rate
      // limited: deleting shrinks the collection, and the create side
      // is already capped, so there is nothing here worth spending a
      // counter on.
      //
      // This rule needed no change for account deletion, and that is
      // worth noticing: these documents carry BOTH uids plus the
      // sender's username, and an accepted request is never deleted by
      // the accept flow — it is marked `accepted` and left. So an
      // erasure sweep has to query both directions with no status
      // filter and delete whatever it finds, which this already
      // permits.
      allow delete: if isSignedIn()
        && (resource.data.from == me() || resource.data.to == me());
    }
  }
}
